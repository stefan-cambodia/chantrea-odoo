# Copier ce fichier en .env puis le remplir.
# Le fichier .env n'est JAMAIS commité (voir .gitignore).

# --- Fichiers Compose -------------------------------------------------------
# En local : ajoute Mailpit et monte le code en direct.
# Sur le serveur : supprimer la ligne (seul docker-compose.yml est utilisé).
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml

# --- Proxy HTTPS (Caddy) ----------------------------------------------------
# En local : localhost (certificat interne de Caddy).
# Sur le serveur : le vrai nom de domaine, ex. erp.exemple.com
DOMAINE=localhost
HTTP_PORT=8080
HTTPS_PORT=8443

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=odoo
# Générer avec : openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Odoo -------------------------------------------------------------------
ODOO_DB_NAME=chantrea
# Mot de passe maître (gestion des bases). Générer avec : openssl rand -base64 32
ODOO_ADMIN_PASSWD=
ODOO_WORKERS=2
ODOO_MAX_CRON_THREADS=1

# --- Courriel sortant -------------------------------------------------------
# En local : Mailpit (interface sur http://localhost:8025)
SMTP_SERVER=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
# True = STARTTLS (à activer sur le serveur)
SMTP_SSL=False
EMAIL_FROM=odoo@localhost

# --- Local uniquement -------------------------------------------------------
# Mot de passe du compte « admin » créé par scripts/init_local.sh
ADMIN_LOCAL_PASSWORD=
