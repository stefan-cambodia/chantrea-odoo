<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A4 aux marges adaptées à l'en-tête bilingue (plus compact que le A4 d'Odoo). -->
    <record id="format_a4_kh" model="report.paperformat">
        <field name="name">A4 – Chantrea (khmer/anglais)</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">36</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">30</field>
        <field name="dpi">90</field>
        <field name="css_margins" eval="False"/>
    </record>

    <!-- Factures, devis et pro forma utilisent ce format. -->
    <record id="account.account_invoices" model="ir.actions.report">
        <field name="paperformat_id" ref="format_a4_kh"/>
    </record>
    <record id="account.account_invoices_without_payment" model="ir.actions.report">
        <field name="paperformat_id" ref="format_a4_kh"/>
    </record>
    <record id="sale.action_report_saleorder" model="ir.actions.report">
        <field name="paperformat_id" ref="format_a4_kh"/>
    </record>
    <record id="sale.action_report_pro_forma_invoice" model="ir.actions.report">
        <field name="paperformat_id" ref="format_a4_kh"/>
    </record>
</odoo>
