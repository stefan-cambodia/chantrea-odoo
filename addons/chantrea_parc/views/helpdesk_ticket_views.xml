<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ticket : équipement(s) concerné(s), choisis parmi le parc du client. -->
    <record id="ticket_view_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.chantrea_parc</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.ticket_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="chantrea_equipement_ids" widget="many2many_tags"
                       options="{'no_create': True}" invisible="not partner_id"/>
            </xpath>
        </field>
    </record>
</odoo>
