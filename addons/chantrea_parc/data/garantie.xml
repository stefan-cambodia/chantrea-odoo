<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="activite_fin_garantie" model="mail.activity.type">
        <field name="name">Warranty ending</field>
        <field name="res_model">fsm.equipment</field>
        <field name="icon">fa-shield</field>
        <field name="delay_count">0</field>
    </record>

    <!-- Chaque jour à 7 h (heure de Phnom Penh) : alertes 60 et 30 jours avant la fin de garantie. -->
    <record id="cron_alertes_garantie" model="ir.cron">
        <field name="name">Chantrea: warranty end alerts (60 and 30 days)</field>
        <field name="model_id" ref="fieldservice.model_fsm_equipment"/>
        <field name="state">code</field>
        <field name="code">model._chantrea_cron_alertes_garantie()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 00:00:00')"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
