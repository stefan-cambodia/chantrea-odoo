<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.chantrea_caisse</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='payment_methods_new']" position="after">
                <setting id="chantrea_riels" string="Riels at the till"
                         help="The till sells in dollars and also accepts riels. Change: whole dollars in notes, the cents in riels.">
                    <div class="content-group">
                        <div class="row mt-2">
                            <label for="pos_chantrea_taux_mode" class="col-lg-4 o_light_label"/>
                            <field name="pos_chantrea_taux_mode" widget="radio"/>
                        </div>
                        <div class="row" invisible="pos_chantrea_taux_mode != 'fixe'">
                            <label for="pos_chantrea_taux_fixe" class="col-lg-4 o_light_label"/>
                            <field name="pos_chantrea_taux_fixe" required="pos_chantrea_taux_mode == 'fixe'"/>
                        </div>
                        <div class="row">
                            <label for="pos_chantrea_arrondi_khr" class="col-lg-4 o_light_label"/>
                            <field name="pos_chantrea_arrondi_khr"/>
                        </div>
                        <div class="row">
                            <label for="pos_chantrea_taux_caisse" class="col-lg-4 o_light_label"/>
                            <field name="pos_chantrea_taux_caisse"/>
                        </div>
                    </div>
                </setting>
                <setting id="chantrea_bakong" string="KHQR payments checked with Bakong" groups="base.group_system"
                         help="With a Bakong API token, the till confirms a KHQR payment as soon as it arrives. Without it, the cashier confirms it.">
                    <div class="content-group">
                        <div class="row mt-2">
                            <label for="chantrea_bakong_token" class="col-lg-4 o_light_label"/>
                            <field name="chantrea_bakong_token" password="True"/>
                        </div>
                        <div class="row">
                            <label for="chantrea_bakong_url" class="col-lg-4 o_light_label"/>
                            <field name="chantrea_bakong_url" placeholder="https://api-bakong.nbc.gov.kh"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
