#. module: chantrea_portail
#: model:mail.template,body_html:chantrea_portail.modele_accuse_reception_ticket
msgid ""
"<div style=\"font-family: 'Noto Sans Khmer', 'Noto Sans', Arial, sans-serif; font-size: 14px; color: #0f1412; line-height: 1.6;\">\n"
"    <p>Hello <t t-out=\"object.partner_id.name or object.partner_name or ''\">Dara</t>,</p>\n"
"    <p>We have received your request <strong t-out=\"object.name or ''\">Printer out of order</strong> under number <strong t-out=\"object.number or ''\">HT00001</strong>.</p>\n"
"    <p>A technician will get back to you as soon as possible. You can follow this request and reply to it in your customer area.</p>\n"
"    <p style=\"margin: 20px 0;\">\n"
"        <a t-att-href=\"object.get_base_url() + object.get_portal_url()\" style=\"background-color: #1f6b3c; color: #ffffff; padding: 10px 18px; border-radius: 6px; text-decoration: none;\">View my request</a>\n"
"    </p>\n"
"    <p>Chantrea Systems</p>\n"
"</div>\n"
"        "
msgstr "<div style=\"font-family: 'Noto Sans Khmer', 'Noto Sans', Arial, sans-serif; font-size: 14px; color: #0f1412; line-height: 1.6;\">\n    <p>Bonjour <t t-out=\"object.partner_id.name or object.partner_name or ''\">Dara</t>,</p>\n    <p>Nous avons bien reçu votre demande <strong t-out=\"object.name or ''\">Printer out of order</strong> sous le numéro <strong t-out=\"object.number or ''\">HT00001</strong>.</p>\n    <p>Un technicien vous répondra dans les meilleurs délais. Vous pouvez suivre cette demande et y répondre depuis votre espace client.</p>\n    <p style=\"margin: 20px 0;\">\n        <a t-att-href=\"object.get_base_url() + object.get_portal_url()\" style=\"background-color: #1f6b3c; color: #ffffff; padding: 10px 18px; border-radius: 6px; text-decoration: none;\">Voir ma demande</a>\n    </p>\n    <p>Chantrea Systems</p>\n</div>\n        "

